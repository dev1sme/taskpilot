# Copy to .env (gitignored). Variables already set in the environment win over this file.

# Listen address. 127.0.0.1 = this machine only. Behind a reverse proxy in Docker, use the
# docker0 address (usually 172.17.0.1) so containers can reach it without exposing it to the LAN.
TASKPILOT_HOST=127.0.0.1
TASKPILOT_PORT=8790

# Hostnames accepted in Host/Origin besides loopback and TASKPILOT_HOST, comma-separated,
# e.g. the reverse proxy's domain: taskpilot.example.dev
TASKPILOT_ALLOWED_HOSTS=

# Login with a user and password (both or neither). Unset: the browser logs in with the token
# the server prints at startup instead. Keep .env at chmod 600.
TASKPILOT_AUTH_USER=
TASKPILOT_AUTH_PASSWORD=

# Without a login: fixed token instead of a random one per start. With a login: optional API
# token for scripts (x-taskpilot-token header), off when empty. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TASKPILOT_TOKEN=

# Optional Codex CLI binary (uses existing Codex login/config)
# TASKPILOT_CODEX=codex
