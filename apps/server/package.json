{
  "name": "@taskpilot/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./api-types": {
      "types": "./dist/types/api-types.d.ts"
    }
  },
  "scripts": {
    "dev": "TASKPILOT_HOST=127.0.0.1 TASKPILOT_PORT=8791 TASKPILOT_TOKEN=dev tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "types": "tsc -p tsconfig.api-types.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run types"
  },
  "dependencies": {
    "@taskpilot/shared": "*",
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.3.4",
    "chokidar": "^5.0.0",
    "diff": "^9.0.0",
    "fastify": "^5.12.7",
    "i18next": "^26.5.3",
    "jsonc-parser": "^3.3.1",
    "marked": "^18.1.1",
    "node-pty": "^1.1.0",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15"
  }
}
