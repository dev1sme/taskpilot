{
  // Declarations of the HTTP API types for the web client (`@taskpilot/server/api-types`), without server code or its global augmentations.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "types",
    // The plugins augment Fastify's types; app.ts, which imports them, is not part of this build.
    "types": ["node", "@fastify/cookie", "@fastify/websocket", "@fastify/static"]
  },
  "include": [],
  "files": ["src/api-types.ts"]
}
