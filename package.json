{
  "name": "taskpilot",
  "version": "0.1.0",
  "private": true,
  "description": "Run Claude Code task workflows from .claude/tasks in an embedded terminal",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "taskpilot": "dist/server/index.js"
  },
  "scripts": {
    "dev:server": "TASKPILOT_HOST=127.0.0.1 TASKPILOT_PORT=8791 TASKPILOT_TOKEN=dev tsx watch server/src/index.ts",
    "dev:client": "TASKPILOT_PORT=8791 vite",
    "build": "vite build && tsc -p tsconfig.json",
    "start": "node dist/server/index.js",
    "typecheck": "npm run types:api && tsc -p tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit",
    "types:api": "tsc -p server/tsconfig.api-types.json",
    "test": "vitest run",
    "e2e": "npm --prefix e2e test",
    "i18n:lint": "i18next-cli lint",
    "lint": "eslint --max-warnings 0 client/src server/src e2e/tests",
    "format": "prettier --write client/src server/src e2e/tests",
    "format:check": "prettier --check client/src server/src e2e/tests"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.3.4",
    "@tanstack/react-query": "^5.104.4",
    "chokidar": "^5.0.0",
    "diff": "^9.0.0",
    "fastify": "^5.12.7",
    "i18next": "^26.5.3",
    "jsonc-parser": "^3.3.1",
    "marked": "^18.1.1",
    "node-pty": "^1.1.0",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/eslint-parser": "^8.0.7",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@hookform/resolvers": "^6.0.1",
    "@lezer/highlight": "^1.2.5",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.46",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@uiw/react-codemirror": "^4.25.12",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.17",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "i18next-cli": "^1.77.0",
    "motion": "^14.3.0",
    "prettier": "3.9.10",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^17.1.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  }
}
