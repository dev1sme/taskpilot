{
  "name": "taskpilot",
  "version": "0.1.0",
  "private": true,
  "description": "Run Claude Code task workflows from .claude/tasks in an embedded terminal",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "taskpilot": "dist/server/index.js"
  },
  "scripts": {
    "dev:server": "TASKPILOT_HOST=127.0.0.1 TASKPILOT_PORT=8791 TASKPILOT_TOKEN=dev tsx watch server/src/index.ts",
    "dev:client": "TASKPILOT_PORT=8791 vite",
    "build": "vite build && tsc -p tsconfig.json",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit",
    "test": "vitest run",
    "e2e": "npm --prefix e2e test",
    "i18n:lint": "i18next-cli lint"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.3.4",
    "@tanstack/react-query": "^5.104.4",
    "chokidar": "^5.0.0",
    "diff": "^9.0.0",
    "fastify": "^5.12.7",
    "i18next": "^26.5.3",
    "marked": "^18.1.1",
    "node-pty": "^1.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@phosphor-icons/react": "^2.1.10",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.17",
    "i18next-cli": "^1.77.0",
    "motion": "^14.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "ws": "^8.22.0"
  }
}
