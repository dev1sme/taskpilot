{
  "name": "taskpilot",
  "version": "0.1.0",
  "private": true,
  "description": "Run Claude Code task workflows from .claude/tasks in an embedded terminal",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "bin": {
    "taskpilot": "apps/server/dist/index.js"
  },
  "scripts": {
    "dev:server": "npm run dev -w @taskpilot/server",
    "dev:web": "TASKPILOT_PORT=8791 npm run dev -w @taskpilot/web",
    "build": "npm run build -w @taskpilot/shared && npm run build -w @taskpilot/server && npm run build -w @taskpilot/web",
    "start": "node apps/server/dist/index.js",
    "typecheck": "npm run build -w @taskpilot/shared && npm run typecheck -w @taskpilot/server && npm run typecheck -w @taskpilot/web",
    "test": "vitest run",
    "e2e": "npm --prefix e2e test",
    "i18n:lint": "i18next-cli lint",
    "lint": "eslint --max-warnings 0 apps packages e2e/tests",
    "format": "prettier --write apps/*/src packages/*/src e2e/tests",
    "format:check": "prettier --check apps/*/src packages/*/src e2e/tests"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/eslint-parser": "^8.0.7",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "i18next-cli": "^1.77.0",
    "prettier": "3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
